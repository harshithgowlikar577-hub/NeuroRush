# ==============================================================================
# NeuroRush — Root .gitignore Configuration
# ==============================================================================

# 1. Environment & Sensitive Credentials (CRITICAL)
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
database/config.json
!database/config.example.json

# 2. Dependencies
node_modules/
backend/node_modules/
jspm_packages/
.pnp
.pnp.js

# 3. Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Scratch & Verification Scripts
scratch/
backend/scratch/
*.tmp

# 5. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
dist/
frontend/build/
frontend/dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. IDE & Editor Artifacts
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Testing & Coverage
coverage/
.nyc_output/

# 9. Antigravity & Agent system generated
.system_generated/
