# Server Configuration
PORT=5000

# Database Configuration (Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=neurorush

# Cloud Database URL Alternative (Railway, Render, PlanetScale, Aiven)
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:3306/neurorush
# DB_SSL=false

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=24h
